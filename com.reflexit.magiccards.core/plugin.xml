      <!-- strict ManaDesk CSV importer: the header must use ManaDesk's exact
           field ids (SET/EDITION_ABBR for the set); database columns a "Full
           CSV" also carries are recognised and ignored, anything else is
           rejected so another importer can try. -->
      <deckFormat
            extension="csv"
            id="mdCsvImport"
            importDelegate="com.reflexit.magiccards.core.exports.ManaDeskCsvImportDelegate"
            label="ManaDesk CSV">
      </deckFormat>
      <deckFormat
            extension="csv"
            id="mdScsvImport"
            importDelegate="com.reflexit.magiccards.core.exports.ManaDeskCsvSemicolonImportDelegate"
            label="ManaDesk CSV Semicolon">
      </deckFormat>
      <!-- Moxfield collection CSV: needs Count, Name, Edition and Collector Number columns.
           BEFORE Deckbox (a Moxfield file also has Count, Name and Edition, so Deckbox would
           parse it too and, on a tie, the first registered wins); a Deckbox file has "Card
           Number", not "Collector Number", so this one rejects it -->
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.MoxfieldCsvExportDelegate"
            extension="csv"
            id="moxfieldCsv"
            importDelegate="com.reflexit.magiccards.core.exports.MoxfieldCsvImportDelegate"
            application="true"
            label="Moxfield Collection CSV"
            xmlFormat="false">
      </deckFormat>
      <!-- Deckstats collection CSV: needs the columns amount and card_name; no other registered
           format uses those names, so the order does not matter -->
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.DeckstatsCsvExportDelegate"
            extension="csv"
            id="deckstatsCsv"
            importDelegate="com.reflexit.magiccards.core.exports.DeckstatsCsvImportDelegate"
            application="true"
            label="Deckstats Collection CSV"
            xmlFormat="false">
      </deckFormat>
      <!-- TappedOut deck CSV: needs the columns Board, Qty and Name; no other registered
           format uses those names, so the order does not matter -->
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.TappedOutCsvExportDelegate"
            extension="csv"
            id="tappedOutCsv"
            importDelegate="com.reflexit.magiccards.core.exports.TappedOutCsvImportDelegate"
            application="true"
            label="TappedOut Deck CSV"
            xmlFormat="false">
      </deckFormat>
      <!-- the same importer reads TappedOut's collection layout (Qty, Name, Set, Set Number...) -->
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.TappedOutCollectionCsvExportDelegate"
            extension="csv"
            id="tappedOutCollectionCsv"
            importDelegate="com.reflexit.magiccards.core.exports.TappedOutCsvImportDelegate"
            application="true"
            label="TappedOut Collection CSV"
            xmlFormat="false">
      </deckFormat>
      <!-- strict Deckbox importer (needs Count, Name and Edition columns); the wishlist
           is export-only: the same importer reads both. BEFORE ManaBox: a Deckbox export
           has a "Scryfall ID" column, so ManaBox would also parse it (same card count,
           no errors) and, on a tie, the first registered wins - while a ManaBox file
           has no Count / Edition column, so Deckbox rejects it -->
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.DeckBoxExportDelegate"
            extension="csv"
            id="deckbox"
            importDelegate="com.reflexit.magiccards.core.exports.DeckBoxImportDelegate"
            application="true"
            label="Deckbox Inventory CSV"
            xmlFormat="false">
      </deckFormat>
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.DeckBoxWishlistExportDelegate"
            extension="csv"
            id="deckboxW"
            application="true"
            label="Deckbox Wishlist CSV"
            xmlFormat="false">
      </deckFormat>
      <!-- before the lenient CSV formats (MTG Studio...): a ManaBox file
           would also parse with them, and on a tie the first registered wins -->
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.ManaBoxCsvExportDelegate"
            extension="csv"
            id="manabox"
            importDelegate="com.reflexit.magiccards.core.exports.ManaBoxCsvImportDelegate"
            application="true"
            label="ManaBox CSV"
            xmlFormat="false">
      </deckFormat>
      <!-- Cockatrice deck (.cod, XML): names and counts, "main" and "side" zones; the
           extension is unique, so a .cod file is detected without scoring -->
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.CockatriceExportDelegate"
            extension="cod"
            id="cockatrice"
            importDelegate="com.reflexit.magiccards.core.exports.CockatriceImportDelegate"
            application="true"
            label="Cockatrice Deck"
            xmlFormat="true">
      </deckFormat>
      <!-- Moxfield deck list ("Copy for Moxfield": "1 Sol Ring (C21) 263 *F*"); rejects a file
           with no line carrying a set code and a number, so a plain list goes to Freeform.
           BEFORE Freeform: on a tie the first registered wins -->
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.MoxfieldTextExportDelegate"
            extension="txt"
            id="moxfieldText"
            importDelegate="com.reflexit.magiccards.core.exports.MoxfieldTextImportDelegate"
            application="true"
            label="Moxfield Deck List"
            xmlFormat="false">
      </deckFormat>
      <!-- Deckstats deck text ("//Main", "1 Lightning Bolt (SLZ) 305"); rejects a file
           with no set code and number, so a plain list goes to Freeform. BEFORE Freeform: on a tie the
           first registered wins -->
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.DeckstatsTextExportDelegate"
            extension="txt"
            id="deckstatsText"
            importDelegate="com.reflexit.magiccards.core.exports.DeckstatsTextImportDelegate"
            application="true"
            label="Deckstats Deck List"
            xmlFormat="false">
      </deckFormat>
      <!-- forgiving text importer: '# name' comments, 'Sideboard' markers,
           '3 Name', '3x Name (Set)', or any line carrying a Scryfall id -->
      <deckFormat
            extension="txt"
            id="freeform"
            importDelegate="com.reflexit.magiccards.core.exports.FreeformImportDelegate"
            label="Freeform Text">
      </deckFormat>
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.CsvExportDelegate"
            extension="csv"
            id="fcsv"
            label="ManaDesk Full CSV">
      </deckFormat>
      <deckFormat
             exportDelegate="com.reflexit.magiccards.core.exports.ScsvExportDelegate"
             extension="csv"
             id="fscsv"
             label="ManaDesk Full CSV Semicolon">
       </deckFormat>
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.MinimumCsvExportDelegate"
            extension="csv"
            id="csv"
            label="ManaDesk Minimum CSV">
      </deckFormat>
      <deckFormat
            exportDelegate="com.reflexit.magiccards.core.exports.MinimumScsvExportDelegate"
            extension="csv"
            id="scsv"
            label="ManaDesk Minimum CSV Semicolon">
      </deckFormat>
      <deckFormat
            extension="csv"
            id="macsv"
            importDelegate="com.reflexit.magiccards.core.exports.MagicAssistantCsvImportDelegate"
            label="Magic Assistant CSV">
      </deckFormat>

